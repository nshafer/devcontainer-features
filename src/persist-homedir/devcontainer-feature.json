{
  "id": "persist-homedir",
  "version": "1.2.0",
  "name": "Persistent home directory (nshafer)",
  "description": "Keeps /home and the VS Code server on Docker named volumes, so both survive a container rebuild. The server has its own volume, so you can delete it alone.",
  "documentationURL": "https://github.com/nshafer/devcontainer-features/tree/main/src/persist-homedir",
  "options": {},
  "mounts": [
    {
      "source": "${localWorkspaceFolderBasename}-persistent-homedir",
      "target": "/home",
      "type": "volume"
    },
    {
      "source": "${localWorkspaceFolderBasename}-vscode-server",
      "target": "/var/local/vscode-server",
      "type": "volume"
    }
  ],
  "entrypoint": "/usr/local/share/devcontainer/persist-homedir/entrypoint.sh",
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
