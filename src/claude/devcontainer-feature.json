{
  "id": "claude",
  "version": "1.1.1",
  "name": "Claude Code (nshafer)",
  "description": "Installs the Claude Code CLI with the native installer.",
  "documentationURL": "https://github.com/nshafer/devcontainer-features/tree/main/src/claude",
  "options": {
    "version": {
      "type": "string",
      "default": "stable",
      "proposals": [
        "stable",
        "latest"
      ],
      "description": "Version to install: 'stable', 'latest', or an exact X.Y.Z."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
