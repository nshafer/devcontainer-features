#!/usr/bin/env python3
"""devc -- a devcontainer CLI wrapper that applies a per-developer override file.

It merges `.devcontainer/devcontainer.local.json` over `.devcontainer/devcontainer.json`,
writes the result to `.devcontainer/local/devcontainer.json`, and adds
`--config .devcontainer/local/devcontainer.json` to the command it runs.

With no override file present, it runs the real CLI unchanged.

Four subcommands belong to devc, and none of them starts the real CLI:
  merge   writes the generated config, and reports what it did.
  merged  prints the generated config, and writes nothing.
  stop    stops the container that belongs to this workspace and config.
  down    stops it and removes it, with the rest of its compose project.

`stop` and `down` find the container by the two labels the CLI stamps on it, so one
lookup covers an image, a Dockerfile and a compose config alike. `--all-configs`
widens the match to every container of the workspace, and `down --volumes` also
removes the named volumes of a compose project.

`--local-config NAME` uses `devcontainer.NAME.json` and the directory `.devcontainer/NAME/`
instead. The default name is `local`. The flag belongs to devc, and the real CLI never sees it.

Merge rules, applied to the override file:
  "key": value   replaces the base value. Two objects merge key by key instead.
  "key+": [...]  appends to the base list.
  "key": null    removes the key.

Both config files sit in `.devcontainer/`, and the generated file sits one level
deeper, so relative paths in either file are rewritten to point at the same place.
"""

from __future__ import annotations

import json
import os
import posixpath
import shlex
import shutil
import subprocess
import sys

PROG = "devc"

# ANSI styles, empty when stdout is not a terminal or NO_COLOR is set.
if sys.stdout.isatty() and not os.environ.get("NO_COLOR"):
    DIM, BOLD, CYAN, MAGENTA, RESET = "\033[2m", "\033[1m", "\033[36m", "\033[35m", "\033[0m"
else:
    DIM = BOLD = CYAN = MAGENTA = RESET = ""

# The devcontainer CLI subcommands that accept --config. `features` and `templates`
# take their own flags, so they pass through untouched.
CONFIG_SUBCOMMANDS = {
    "build",
    "exec",
    "open",
    "outdated",
    "read-configuration",
    "run-user-commands",
    "set-up",
    "up",
    "upgrade",
}

# Subcommands that belong to devc. None of them reaches the real CLI.
DEVC_SUBCOMMANDS = {"merge", "merged", "stop", "down"}

# Every other subcommand, so that a flag written before the subcommand cannot be
# mistaken for one.
OTHER_SUBCOMMANDS = {"features", "templates"} | DEVC_SUBCOMMANDS

# Flags that take a value, and that someone may write before the subcommand.
VALUE_FLAGS = {"--workspace-folder", "--config", "--override-config", "--log-level", "--log-format"}

# Keys whose value is a path relative to the directory that holds the config file.
TOP_LEVEL_PATH_KEYS = ("dockerComposeFile", "dockerFile", "context")
BUILD_PATH_KEYS = ("dockerfile", "context")

# Base config files, in the order the spec looks for them.
BASE_NAMES = (os.path.join(".devcontainer", "devcontainer.json"), ".devcontainer.json")

# The override file is devcontainer.NAME.json, and the generated config goes in .devcontainer/NAME/.
DEFAULT_NAME = "local"
OUTPUT_NAME = "devcontainer.json"


def die(message: str):  # noqa: F821
    print(f"{PROG}: {message}", file=sys.stderr)
    raise SystemExit(2)


def warn(message: str) -> None:
    print(f"{PROG}: {message}", file=sys.stderr)


# --------------------------------------------------------------------------- JSONC

def _skip_string(text: str, i: int) -> int:
    """Return the index just past the string literal that starts at `i`."""
    j = i + 1
    n = len(text)
    while j < n:
        if text[j] == "\\":
            j += 2
            continue
        if text[j] == '"':
            return j + 1
        j += 1
    return n


def strip_comments(text: str) -> str:
    out = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            j = _skip_string(text, i)
            out.append(text[i:j])
            i = j
        elif c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
        elif c == "/" and i + 1 < n and text[i + 1] == "*":
            i += 2
            while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def strip_trailing_commas(text: str) -> str:
    out = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            j = _skip_string(text, i)
            out.append(text[i:j])
            i = j
            continue
        if c == ",":
            j = i + 1
            while j < n and text[j] in " \t\r\n":
                j += 1
            if j < n and text[j] in "}]":
                i += 1
                continue
        out.append(c)
        i += 1
    return "".join(out)


def read_jsonc(path: str) -> dict:
    """Read a devcontainer.json. Comments and trailing commas are allowed."""
    try:
        with open(path, encoding="utf-8") as handle:
            raw = handle.read()
    except OSError as error:
        die(f"cannot read {path}: {error.strerror}")
    if not raw.strip():
        return {}
    try:
        value = json.loads(strip_trailing_commas(strip_comments(raw)))
    except json.JSONDecodeError as error:
        die(f"{path} is not valid JSON: line {error.lineno} column {error.colno}: {error.msg}")
    if not isinstance(value, dict):
        die(f"{path} must hold a JSON object at the top level")
    return value


# --------------------------------------------------------------------------- merge

def merge(base: dict, override: dict, trail: str = "") -> dict:
    result = dict(base)
    for key, value in override.items():
        where = f"{trail}.{key}" if trail else key

        if key.endswith("+") and len(key) > 1:
            target = key[:-1]
            current = result.get(target)
            if not isinstance(value, list):
                die(f'"{where}" must hold a list, because the "+" suffix appends to a list')
            if current is None:
                result[target] = list(value)
            elif isinstance(current, list):
                result[target] = current + list(value)
            else:
                spot = f"{trail}.{target}" if trail else target
                die(f'cannot append to "{spot}", because the base value is not a list')
            continue

        if value is None:
            result.pop(key, None)
            continue

        current = result.get(key)
        if isinstance(current, dict) and isinstance(value, dict):
            result[key] = merge(current, value, where)
        else:
            result[key] = value
    return result


# --------------------------------------------------------------- relative paths

def is_relative_path(value: object) -> bool:
    return (
        isinstance(value, str)
        and value != ""
        and not value.startswith(("/", "~", "$", "\\"))
        and not (len(value) > 1 and value[1] == ":")  # a Windows drive letter
    )


def rebase(prefix: str, value: str) -> str:
    """Move a path so that it names the same file from the generated config."""
    return posixpath.normpath(posixpath.join(prefix, value))


def rebase_feature(prefix: str, key: str) -> str:
    """Move a local feature path. The CLI needs the "./" or "../" prefix to keep it."""
    moved = rebase(prefix, key)
    return moved if moved.startswith(("./", "../")) else "./" + moved


def rebase_paths(config: dict, prefix: str) -> dict:
    result = dict(config)

    for key in TOP_LEVEL_PATH_KEYS:
        value = result.get(key)
        if is_relative_path(value):
            result[key] = rebase(prefix, value)
        elif isinstance(value, list):
            result[key] = [rebase(prefix, v) if is_relative_path(v) else v for v in value]

    build = result.get("build")
    if isinstance(build, dict):
        build = dict(build)
        for key in BUILD_PATH_KEYS:
            if is_relative_path(build.get(key)):
                build[key] = rebase(prefix, build[key])
        # The build context defaults to the directory of the config file, and the
        # generated config sits in a different directory. Name the old default.
        if "dockerfile" in build and "context" not in build:
            build["context"] = prefix
        result["build"] = build

    # The same default, for the older top-level form.
    if "dockerFile" in result and "context" not in result:
        result["context"] = prefix

    features = result.get("features")
    if isinstance(features, dict):
        result["features"] = {
            (rebase_feature(prefix, key) if key.startswith(("./", "../")) else key): value
            for key, value in features.items()
        }

    return result


# ----------------------------------------------------------------------- files

def override_path_for(base_path: str, name: str) -> str:
    return base_path[: -len(".json")] + f".{name}.json"


def find_configs(workspace: str, name: str) -> "tuple[str | None, str | None]":
    """Return (base config path, override config path). Either may be None."""
    for candidate in BASE_NAMES:
        base = os.path.join(workspace, candidate)
        if os.path.isfile(base):
            override = override_path_for(base, name)
            return base, (override if os.path.isfile(override) else None)

    # An override file with no base config still describes a whole container.
    for candidate in BASE_NAMES:
        override = override_path_for(os.path.join(workspace, candidate), name)
        if os.path.isfile(override):
            return None, override
    return None, None


def write_if_changed(path: str, content: str) -> bool:
    """Write the file only where the content differs. Return True after a write.

    The skipped write matters: VS Code watches the generated config, and a rewrite
    with the same bytes still asks to rebuild the container.
    """
    try:
        with open(path, encoding="utf-8") as handle:
            if handle.read() == content:
                return False
    except OSError:
        pass
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(content)
    except OSError as error:
        die(f"cannot write {path}: {error.strerror}")
    return True


def output_path(workspace: str, name: str) -> str:
    """Return the path of the generated config, whether or not it exists yet."""
    return os.path.join(workspace, ".devcontainer", name, OUTPUT_NAME)


def build_config(workspace: str, base_path: "str | None", override_path: str,
                 name: str) -> "tuple[str, str, str]":
    """Return (output path, merged JSON, whole file content). This writes nothing."""
    out_path = output_path(workspace, name)
    out_dir = os.path.dirname(out_path)

    source_dir = os.path.dirname(base_path or override_path)
    prefix = os.path.relpath(source_dir, out_dir).replace(os.sep, "/")

    base = read_jsonc(base_path) if base_path else {}
    merged = rebase_paths(merge(base, read_jsonc(override_path)), prefix)
    merged_json = json.dumps(merged, indent=2)

    sources = [posixpath.join(prefix, os.path.basename(p))
               for p in (base_path, override_path) if p]
    header = (
        f"// Generated by {PROG}. Every edit here is lost on the next run.\n"
        f"// Source: {' + '.join(sources)}\n"
    )

    return out_path, merged_json, header + merged_json + "\n"


def generate(workspace: str, base_path: "str | None", override_path: str,
             name: str) -> "tuple[str, bool]":
    """Write the generated config. Return (output path, True after a write)."""
    out_path, _, content = build_config(workspace, base_path, override_path, name)
    out_dir = os.path.dirname(out_path)

    try:
        os.makedirs(out_dir, exist_ok=True)
    except OSError as error:
        die(f"cannot create {out_dir}: {error.strerror}")

    # Keep the generated directory out of the repository on its own.
    write_if_changed(os.path.join(out_dir, ".gitignore"), "*\n")
    return out_path, write_if_changed(out_path, content)


def warn_if_committable(workspace: str, override_path: str, name: str) -> None:
    try:
        result = subprocess.run(
            ["git", "-C", workspace, "check-ignore", "-q", override_path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return
    if result.returncode == 1:
        shown = os.path.relpath(override_path, workspace)
        warn(f"{shown} is not ignored by git. Add '*.{name}.json' to .gitignore.")


# ---------------------------------------------------------------------- docker

# The two labels the CLI stamps on the container it creates. The compose path writes
# the same pair into its generated override file, so this one lookup finds the
# container of an image config, a Dockerfile config and a compose config alike.
LABEL_FOLDER = "devcontainer.local_folder"
LABEL_CONFIG = "devcontainer.config_file"

# Compose puts the project on every container it owns. Its presence is what tells
# the two container kinds apart after the fact.
COMPOSE_PROJECT = "com.docker.compose.project"


def docker_cli() -> "list[str]":
    """Return the command that talks to the container engine."""
    override = os.environ.get("DEVC_DOCKER")
    if override:
        # A path wins as it stands, so a directory name with a space still works.
        return [override] if os.path.exists(override) else shlex.split(override)
    for name in ("docker", "podman"):
        found = shutil.which(name)
        if found:
            return [found]
    die("cannot find docker or podman on PATH. Set DEVC_DOCKER.")


def compose_cli(docker: "list[str]") -> "list[str]":
    """Return the command that drives compose. The engine's own subcommand wins."""
    if quiet(docker + ["compose", "version"]) == 0:
        return docker + ["compose"]
    for name in ("docker-compose", "podman-compose"):
        found = shutil.which(name)
        if found:
            return [found]
    die("cannot find `docker compose` or docker-compose. Install one of them.")


def quiet(command: "list[str]") -> int:
    """Run a command, hide its output, and return its exit code."""
    try:
        return subprocess.run(
            command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ).returncode
    except OSError as error:
        die(f"cannot run {command[0]}: {error.strerror}")


def capture(command: "list[str]") -> str:
    try:
        result = subprocess.run(command, capture_output=True, text=True)
    except OSError as error:
        die(f"cannot run {command[0]}: {error.strerror}")
    if result.returncode != 0:
        die(f"{command[0]} failed: {result.stderr.strip() or result.returncode}")
    return result.stdout


def show(command: "list[str]") -> int:
    """Run a command with its output on the terminal, and return its exit code."""
    try:
        return subprocess.run(command).returncode
    except OSError as error:
        die(f"cannot run {command[0]}: {error.strerror}")


def find_containers(docker: "list[str]", workspace: str,
                    config_path: "str | None") -> "list[str]":
    """Return the ids of the containers the CLI created for this workspace."""
    command = docker + ["ps", "-aq", "--filter", f"label={LABEL_FOLDER}={workspace}"]
    if config_path:
        command += ["--filter", f"label={LABEL_CONFIG}={config_path}"]
    return capture(command).split()


def container_labels(docker: "list[str]", container: str) -> dict:
    raw = capture(docker + ["inspect", "-f", "{{json .Config.Labels}}", container]).strip()
    try:
        return json.loads(raw) or {}
    except json.JSONDecodeError:
        return {}


def say(message: str) -> None:
    print(f"{MAGENTA}{PROG}{RESET}: {message}", flush=True)


def report_nothing(docker: "list[str]", workspace: str, config_path: str,
                   all_configs: bool) -> None:
    """Explain an empty match, and name the configs the workspace does have."""
    others = [] if all_configs else find_containers(docker, workspace, None)
    if not others:
        say(f"No container for {CYAN}{config_path}{RESET}")
        return
    configs = sorted({container_labels(docker, c).get(LABEL_CONFIG, "?") for c in others})
    warn(f"no container for {config_path}. This workspace has containers from:")
    for item in configs:
        warn(f"  {item}")
    warn("Name one with --local-config NAME or --config PATH, or use --all-configs.")
    raise SystemExit(1)


def stop_or_down(subcommand: str, workspace: str, config_path: str,
                 all_configs: bool, remove_volumes: bool) -> None:
    """Stop the container of this workspace, and remove it where `down` asks."""
    docker = docker_cli()
    containers = find_containers(docker, workspace, None if all_configs else config_path)
    if not containers:
        report_nothing(docker, workspace, config_path, all_configs)
        return

    # A compose container is handled through compose and by project, because the other
    # services of the project exist to serve it. `docker compose -p NAME down` needs no
    # compose file, so a generated override that is already gone costs nothing here.
    projects: "list[str]" = []
    plain: "list[str]" = []
    for container in containers:
        project = container_labels(docker, container).get(COMPOSE_PROJECT)
        if not project:
            plain.append(container)
        elif project not in projects:
            projects.append(project)

    verb = "Stopping" if subcommand == "stop" else "Removing"
    failed = 0

    if projects:
        compose = compose_cli(docker)
        action = ["stop"] if subcommand == "stop" else ["down"]
        if remove_volumes:
            action.append("--volumes")
        for project in projects:
            say(f"{verb} compose project {BOLD}{CYAN}{project}{RESET}")
            failed += bool(show(compose + ["-p", project] + action))

    if plain:
        action = ["stop"] if subcommand == "stop" else ["rm", "-f"]
        say(f"{verb} container {BOLD}{CYAN}{' '.join(plain)}{RESET}")
        failed += bool(show(docker + action + plain))

    if failed:
        raise SystemExit(1)


# ------------------------------------------------------------------------ args

def take_flag(args: "list[str]", flag: str) -> "str | None":
    """Remove a devc flag and its value from `args`. Return the value, or None."""
    value = None
    kept = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == flag:
            if index + 1 >= len(args):
                die(f"{flag} needs a name, such as 'local'")
            value = args[index + 1]
            index += 2
            continue
        if arg.startswith(flag + "="):
            value = arg[len(flag) + 1:]
            index += 1
            continue
        kept.append(arg)
        index += 1
    args[:] = kept
    return value


def take_switch(args: "list[str]", *names: str) -> bool:
    """Remove a devc switch from `args`. Return True where it was there."""
    found = any(arg in names for arg in args)
    args[:] = [arg for arg in args if arg not in names]
    return found


def check_name(name: str) -> str:
    """A name goes into two file paths, so it has to stay a single path segment."""
    if not name or name in (".", "..") or name.startswith(".") or "/" in name or "\\" in name:
        die(f"--local-config '{name}' is not a plain name. Use something like 'local' or 'gpu'.")
    return name


def flag_value(args: "list[str]", name: str) -> "str | None":
    for index, arg in enumerate(args):
        if arg == name and index + 1 < len(args):
            return args[index + 1]
        if arg.startswith(name + "="):
            return arg[len(name) + 1:]
    return None


def find_subcommand(args: "list[str]") -> "int | None":
    known = CONFIG_SUBCOMMANDS | OTHER_SUBCOMMANDS
    for index, arg in enumerate(args):
        if arg not in known:
            continue
        if index > 0 and args[index - 1] in VALUE_FLAGS:
            continue  # the value of a flag, not the subcommand
        return index
    return None


def real_cli() -> "list[str]":
    """Return the command that starts the real CLI, as a list of arguments."""
    override = os.environ.get("DEVCONTAINER_CLI")
    if override:
        # A path wins as it stands, so a directory name with a space still works.
        # Anything else is a command line, such as "npx @devcontainers/cli".
        return [override] if os.path.exists(override) else shlex.split(override)

    self_path = os.path.realpath(__file__)
    for candidate in (shutil.which("devcontainer"), os.path.expanduser("~/bin/devcontainer")):
        if candidate and os.path.realpath(candidate) != self_path and os.access(candidate, os.X_OK):
            return [candidate]

    # Last resort. npx asks before it downloads the package, and the npm build has no
    # `open` subcommand. `open` belongs to the CLI that VS Code installs.
    npx = shutil.which("npx")
    if npx:
        warn("no devcontainer CLI on PATH. Using npx @devcontainers/cli, which has no `open`.")
        return [npx, "@devcontainers/cli"]

    die(
        "cannot find the devcontainer CLI. Install it with the VS Code command "
        "\"Dev Containers: Install devcontainer CLI\", or set DEVCONTAINER_CLI."
    )


def run(command: "list[str]"):  # noqa: F821
    # execvp and not execv, so that a bare name such as "npx" resolves on PATH.
    try:
        os.execvp(command[0], command)
    except OSError as error:
        die(f"cannot run {command[0]}: {error.strerror}")


def main(argv: "list[str]") -> None:
    args = list(argv)
    # --local-config belongs to devc. Take it out before the real CLI sees it.
    chosen = take_flag(args, "--local-config")
    name = check_name(DEFAULT_NAME if chosen is None else chosen)

    workspace = os.path.abspath(flag_value(args, "--workspace-folder") or ".")
    index = find_subcommand(args)
    subcommand = args[index] if index is not None else None
    base_path, override_path = find_configs(workspace, name)

    # `stop` and `down` belong to devc. They talk to the engine and not to the CLI.
    if subcommand in ("stop", "down"):
        rest = args[:index] + args[index + 1:]
        all_configs = take_switch(rest, "--all-configs")
        remove_volumes = take_switch(rest, "--volumes", "-v")
        given = take_flag(rest, "--config")
        take_flag(rest, "--workspace-folder")
        if rest:
            die(f"{subcommand} does not take {rest[0]}")
        if remove_volumes and subcommand == "stop":
            die("--volumes belongs to down, not to stop")

        # The label holds the config the container was created from, which is the
        # generated file wherever an override exists.
        if given:
            config_path = os.path.abspath(given)
        elif override_path:
            config_path = output_path(workspace, name)
        elif base_path:
            config_path = base_path
        else:
            die(f"no devcontainer.json in {workspace}")
        stop_or_down(subcommand, workspace, config_path, all_configs, remove_volumes)
        return

    # `merge` and `merged` belong to devc. Neither one starts the real CLI.
    if subcommand in ("merge", "merged"):
        if not override_path:
            die(f"no .devcontainer/devcontainer.{name}.json in {workspace}")
        warn_if_committable(workspace, override_path, name)

        if subcommand == "merged":
            # Read only, so the output pipes into jq and leaves the file alone.
            _, merged_json, _ = build_config(workspace, base_path, override_path, name)
            print(merged_json)
            return

        config_path, changed = generate(workspace, base_path, override_path, name)
        if changed:
            shown = os.path.relpath(config_path, workspace)
            source = os.path.relpath(override_path, workspace)
            print(
                f"{MAGENTA}{PROG}{RESET}: Wrote {BOLD}{CYAN}{shown}{RESET}"
                f" from {CYAN}{source}{RESET}"
            )
        else:
            print(f"{MAGENTA}{PROG}{RESET}: No changes detected")
        return

    cli = real_cli()

    if subcommand not in CONFIG_SUBCOMMANDS or flag_value(args, "--config") is not None:
        run(cli + args)

    if not override_path:
        run(cli + args)

    warn_if_committable(workspace, override_path, name)
    config_path, _ = generate(workspace, base_path, override_path, name)
    shown = os.path.relpath(override_path, workspace)
    print(
        f"{MAGENTA}{PROG}{RESET}: Running {BOLD}{CYAN}{subcommand}{RESET}"
        f" with override from {CYAN}{shown}{RESET}",
        flush=True,
    )
    run(cli + args[: index + 1] + ["--config", config_path] + args[index + 1:])


if __name__ == "__main__":
    main(sys.argv[1:])
