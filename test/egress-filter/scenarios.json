{
  "strict": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "node",
    "features": {
      "egress-filter": {
        "baseline": false,
        "allow": "example.com,.iana.org",
        "deny": ".iana.org",
        "allowDns": false,
        "proxyPort": "8888"
      }
    }
  },
  "presets": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "node",
    "features": {
      "egress-filter": {
        "presets": "debian,npm,go"
      }
    }
  },
  "pinned-dns": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "node",
    "features": {
      "egress-filter": {
        "allow": "example.com",
        "dnsServers": "192.0.2.53"
      }
    }
  }
}
