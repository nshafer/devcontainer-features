{
  "strict": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "egress-filter": {
        "baseline": false,
        "allow": "example.com,.iana.org",
        "deny": ".iana.org",
        "allowDns": false,
        "proxyPort": "8888",
        "localNetworks": "off"
      }
    }
  },
  "presets": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "egress-filter": {
        "presets": "debian,npm,go"
      }
    }
  },
  "pinned-dns": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "egress-filter": {
        "allow": "example.com",
        "dnsServers": "192.0.2.53"
      }
    }
  },
  "local-networks": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "egress-filter": {
        "allow": "example.com",
        "localNetworks": "192.168.222.0/24",
        "noProxy": "db,redis"
      }
    }
  },
  "privileged": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "egress-filter": {}
    }
  },
  "docker-in-docker": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "egress-filter": {
        "presets": "docker",
        "allow": "example.com"
      },
      "ghcr.io/devcontainers/features/docker-in-docker:4": {
        "moby": false
      }
    }
  },
  "mounted-global": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "mounts": [
      "type=bind,src=${localEnv:HOME}/.config/egress-filter,dst=/mnt/egress-filter,readonly"
    ],
    "features": {
      "egress-filter": {}
    }
  }
}
