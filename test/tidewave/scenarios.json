{
  "custom_port": {
    "image": "node",
    "remoteUser": "node",
    "features": {
      "tidewave": {
        "port": "9876",
        "allowRemoteAccess": false,
        "debug": true
      }
    }
  },
  "no_autostart": {
    "image": "node",
    "remoteUser": "node",
    "features": {
      "tidewave": {
        "autostart": false
      }
    }
  },
  "musl_image": {
    "image": "mcr.microsoft.com/devcontainers/base:alpine",
    "remoteUser": "vscode",
    "features": {
      "tidewave": {}
    }
  }
}
