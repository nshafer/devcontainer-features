{
  "sudo_kept": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "node",
    "features": {
      "sandbox": {
        "dropSudo": false
      }
    }
  },
  "channels_off": {
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "remoteUser": "vscode",
    "features": {
      "sandbox": {
        "blockSshAgent": false,
        "blockGpgAgent": false,
        "blockX11": false,
        "blockVscodeIpc": false,
        "scrubEnv": false,
        "sweepInterval": "5",
        "dropSudo": false
      }
    }
  },
  "wayland_bind_mount": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "node",
    "capAdd": [
      "SYS_ADMIN"
    ],
    "securityOpt": [
      "apparmor=unconfined"
    ],
    "features": {
      "sandbox": {
        "dropSudo": false
      }
    }
  }
}
