{
  "privileged_paths": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "sandbox": {}
    }
  },
  "channels_off": {
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "remoteUser": "root",
    "features": {
      "sandbox": {
        "blockSshAgent": false,
        "blockGpgAgent": false,
        "blockX11": false,
        "blockCodeCli": false,
        "blockGitAskpass": false,
        "blockExtensionIpc": false,
        "scrubEnv": false,
        "sweepInterval": "5"
      }
    }
  },
  "ipc_all_on": {
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "remoteUser": "root",
    "features": {
      "sandbox": {
        "blockCodeCli": true,
        "blockGitAskpass": true,
        "blockExtensionIpc": true
      }
    }
  },
  "wayland_bind_mount": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "capAdd": [
      "SYS_ADMIN"
    ],
    "securityOpt": [
      "apparmor=unconfined"
    ],
    "features": {
      "sandbox": {}
    }
  },
  "restricted_sudo": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "node",
    "features": {
      "sandbox": {
        "sudoMode": "restricted",
        "sudoCommands": "/usr/bin/id -u,/usr/bin/cp /etc/hosts /etc/hosts.bak"
      }
    }
  },
  "restricted_sudo_policy": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "remoteUser": "root",
    "features": {
      "sandbox": {
        "sudoMode": "restricted",
        "sudoCommands": "/usr/bin/id -u"
      }
    }
  }
}
